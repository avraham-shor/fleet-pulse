# FleetPulse — environment variables
#
# Copy to .env (gitignored) to override locally. Every other tunable lives
# in shared/constants.js (AD-2) — env vars exist only for this one seam,
# per the architecture spine's Config convention.

# HTTP port server.js listens on, and the port vite.config.ts's dev proxy
# targets for /api and /ws (both read the same variable, so they can never
# drift). Falls back to SERVER_PARAMS.SERVER_PORT (3000) if unset.
PORT=3000
